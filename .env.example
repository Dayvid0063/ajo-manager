# .env.example

# App
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_SESSION_PASSWORD=change-me-min-32-chars-long-random

# Database
# Local (Docker single-node replica set — see docker-compose.yml)
NUXT_MONGODB_URI=mongodb://localhost:27017/ajo-manager?directConnection=true
MONGODB_PORT=27017
# Production (Atlas):
# NUXT_MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/ajo-manager?retryWrites=true&w=majority

# Management fee
NUXT_MANAGEMENT_FEE_KOBO=370000
NUXT_PLATFORM_BANK_NAME=
NUXT_PLATFORM_BANK_ACCOUNT_NUMBER=
NUXT_PLATFORM_BANK_ACCOUNT_NAME=

# Cloudflare R2
NUXT_R2_ACCOUNT_ID=
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_BUCKET=
NUXT_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
